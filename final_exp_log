for all models, use mapping in cli.py to run the following commands


pre unlearn  phase

for all models 

cleanslate fsid validate \                                                                                                                                       ✔ │ CleanSlate Py │ system Node │ animjha@skampere3 │ 18:56:50 ▓▒░
  -m  allenai/Olmo-3-1125-32B \
  -B gsm8k \
  -o results/final/validation/<olmo-32b>/pre_val_gsm8k.json

# this doesnt need tp or g
cleanslate fsid qa eval \
  -m allenai/Olmo-3-1125-32B  \
  -d unlearning-cleanslate/cleanslate_dataset \
  -c qa_benchmark \
  --judge \
  -o results/final/validation/<olmo-32b>/pre_val_qa_dataset.json


cleanslate fsid build-pool \
  --eval-dataset unlearning-cleanslate/eval_cleanslate_dataset_<olmo-7b> \
  --threshold 0.10 \
  --target-size 200 \
  --forget-fraction 0.30 \
  --min-size 50 \
  --max-size 300 \
  --output-dir data/final/<olmo-7b>/pool


cleanslate fsid curate \
  --forget-set-rule baseline \
  --forget-pool-path data/final/<olmo-7b>/forget.parquet \
  --base-dataset allenai/dolma3_mix-6T \
  --output-dir data/final/curated/<olmo-7b>/baseline

unlearn  phase 
for all models except 32 b run for both npo and simnpo
CUDA_VISIBLE_DEVICES="5" cleanslate fsid train \
    -m "allenai/Olmo-3-1025-7B" \
    --config cleanslate/fsid/configs/<npo>.yaml -m "allenai/Olmo-3-1025-7B" \
    --forget-path data/final/curated/<olmo-7b>/baseline/forget_set.parquet \
    --retain-path data/final/curated/<olmo-7b>/baseline/retain_set.parquet \
    --objective <npo> \
    --train-mode full \
    --epochs 1 \
    --batch-size 16 \
    --grad-accum 2 \
    --output-dir results/final/unlearnt_models/<olmo-7b>/<npo>


CUDA_VISIBLE_DEVICES="3,5" accelerate launch --num_processes 2 -m cleanslate fsid train \
  --config cleanslate/fsid/configs/<simnpo>.yaml \
  -m "allenai/Olmo-3-1125-32B" \
  --forget-path  data/final/curated/olmo-32b/baseline/forget_set.parquet \
  --retain-path  data/final/curated/olmo-32b/baseline/retain_set.parquet \
  --objective <simnpo> \
  --distributed-strategy fsdp --fsdp-sharding-strategy full_shard --gradient-checkpointing   --fsdp-cpu-offload \
  --output-dir results/final/unlearnt_models/olmo-32b/<npo> \
  --epochs 1 \
  --batch-size 8 \
  --grad-accum 2 


post unlearn phase figure out relevant subfolder in output dir (or i will give list)

cleanslate eval \
    -d unlearning-cleanslate/cleanslate_dataset \
    -c default \
    -m <model-output-dir>/<unlearn-run-id> \
    --reproduce-all \
    --hf-push unlearning-cleanslate/eval_cleanslate_dataset_<olmo-32b>_post_unlearn \
    --tp-size 2 \
    --num-gpus 4 \
    --mem-fraction 0.9\
    --gpu-ids 4,5,6,7

cleanslate fsid validate \                                                                                                                                       ✔ │ CleanSlate Py │ system Node │ animjha@skampere3 │ 18:56:50 ▓▒░
  -m  <model-output-dir>/<unlearn-run-id> \
  -B gsm8k \
  -o results/final/validation/<olmo-32b>/post_val_gsm8k.json

# this doesnt need tp or g
cleanslate fsid qa eval \
  -m <model-output-dir>/<unlearn-run-id>  \
  -d unlearning-cleanslate/cleanslate_dataset \
  -c qa_benchmark \
  --judge \
  -o results/final/validation/<olmo-32b>/post_val_qa_dataset.json


cleanslate fsid qa score \
  --forget-path data/final/curated/<olmo-7b>/baseline/forget_set.parquet \
  --pre-qa results/final/validation/<olmo-32b>/pre_val_qa_dataset.json \
  --post-qa results/final/validation/<olmo-32b>/post_val_qa_dataset.json \
  -o results/final/validation/<olmo-32b>/score/qa.json

cleanslate fsid score \
  --forget-path data/final/curated/<olmo-32b>/baseline/forget_set.parquet \
  --pre-eval unlearning-cleanslate/eval_cleanslate_dataset_<olmo-32b>:train  \
  --post-eval unlearning-cleanslate/eval_cleanslate_dataset_<olmo-32b>_post_unlearn:train \
  --pre-validation results/final/validation/<olmo-32b>/pre_val_gsm8k.json \
  --post-validation results/final/validation/<olmo-32b>/post_val_gsm8k.json \
  -o results/final/validation/<olmo-32b>/score/score.json